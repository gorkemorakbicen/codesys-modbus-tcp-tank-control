(*
===============================================================================
PLC_PRG
Main control program for the Modbus TCP tank simulation
===============================================================================
*)

(*
===============================================================================
DECLARATION
===============================================================================
*)

PROGRAM PLC_PRG
VAR
    // Raw values read via Modbus
    wTankLevelRaw : WORD;
    wTemperatureRaw : WORD;

    // Scaled values used in CODESYS
    rTankLevelPercent : REAL;
    rTemperatureC : REAL;

    // Control commands generated by the PLC
    xPumpCommand : BOOL;
    xValveCommand : BOOL;

    // 16-bit register values written via Modbus
    wPumpCommandRaw : WORD;
    wValveCommandRaw : WORD;
	
    eTankState : E_TankState := E_TankState.INIT;

    rLowLevelLimit : REAL := 32.0;
    rHighLevelLimit : REAL := 68.0;
	
    // Operating mode
    xAutoMode : BOOL := TRUE;

    // Manual mode requests
    xManualPumpRequest : BOOL;
    xManualValveRequest : BOOL;
	
    // Indicates conflicting manual commands
    xManualConflict : BOOL;
	
    xModbusConnected : BOOL;
    xCommunicationFault : BOOL;
    xFaultResetRequest : BOOL;
	
    fbCommLossDelay : TON;
    fbFaultResetEdge : R_TRIG;

END_VAR

(*
===============================================================================
IMPLEMENTATION
===============================================================================
*)

// Convert raw Modbus values into engineering units
rTankLevelPercent := WORD_TO_REAL(wTankLevelRaw) / 10.0;
rTemperatureC := WORD_TO_REAL(wTemperatureRaw) / 10.0;


// Check the Modbus TCP connection status
xModbusConnected :=
    (Modbus_TCP_Client.uiConnectedSlaves > 0);


// Detect a communication failure if the connection remains unavailable for 7 seconds
fbCommLossDelay(
    IN := NOT xModbusConnected,
    PT := T#7S
);


// Detect only the rising edge of the fault reset request
fbFaultResetEdge(
    CLK := xFaultResetRequest
);


// Latch the communication fault
IF fbCommLossDelay.Q THEN
    xCommunicationFault := TRUE;
END_IF;


// Clear the fault only after communication is restored and a reset is requested
IF xCommunicationFault
   AND xModbusConnected
   AND fbFaultResetEdge.Q THEN

    xCommunicationFault := FALSE;

END_IF;


// Set outputs to their safe default state at the beginning of each PLC cycle
xPumpCommand := FALSE;
xValveCommand := FALSE;


// Detect conflicting manual commands
xManualConflict :=
    xManualPumpRequest AND xManualValveRequest;


// Highest priority: communication safety
IF (NOT xModbusConnected) OR xCommunicationFault THEN

    eTankState := E_TankState.COMM_FAULT;


// Second priority: automatic operation
ELSIF xAutoMode THEN

    CASE eTankState OF

        E_TankState.INIT:

            IF rTankLevelPercent >= rHighLevelLimit THEN
                eTankState := E_TankState.DRAINING;
            ELSE
                eTankState := E_TankState.FILLING;
            END_IF;


        E_TankState.FILLING:

            xPumpCommand := TRUE;

            IF rTankLevelPercent >= rHighLevelLimit THEN
                eTankState := E_TankState.DRAINING;
            END_IF;


        E_TankState.DRAINING:

            xValveCommand := TRUE;

            IF rTankLevelPercent <= rLowLevelLimit THEN
                eTankState := E_TankState.FILLING;
            END_IF;


        E_TankState.COMM_FAULT:

            // Perform a controlled restart after communication is restored
            eTankState := E_TankState.INIT;


        ELSE

            eTankState := E_TankState.INIT;

    END_CASE;


// Third priority: manual operation
ELSE

    eTankState := E_TankState.INIT;

    IF NOT xManualConflict THEN
        xPumpCommand := xManualPumpRequest;
        xValveCommand := xManualValveRequest;
    END_IF;

END_IF;


// Convert BOOL commands into Modbus register values
wPumpCommandRaw := BOOL_TO_WORD(xPumpCommand);
wValveCommandRaw := BOOL_TO_WORD(xValveCommand);